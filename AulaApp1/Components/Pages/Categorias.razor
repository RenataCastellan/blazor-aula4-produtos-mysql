@page "/categorias"

<h3 class="mb-4">Categorias</h3>
<div class="row">
	<div class="col-md-4">
		<div class="card card-body">
			<label class="form-label">Nome</label>
			<input class="form-control" @bind="nome" />
			<label class="form-label">Quantidade</label>
			<input class="form-control" type="number" @bind="quantidade" />
			<button class="btn btn-primary" @onclick="AdicionarCategoria">Adicionar categoria</button>
		</div>
	</div>

	<div class="col-md-8">
		<table class="table table-striped table-hover">
			<thead>
				<tr>
					<th>Categoria</th>
					<th>Quantidade</th>
				</tr>
			</thead>
			<tbody>
				@if (categorias.Count == 0)
				{
					<p class="text-muted">Nenhuma categoria foi cadastrada</p>
				}


				@foreach (var c in categorias)
				{
					<tr>
						<td>@c.Nome</td>
						<td>@c.Quantidade</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

</div>
@code {
	private Produto novo = new Produto();

	private string nome = "";
	private int quantidade;

	private List<Categoria> categorias = new();

	private void AdicionarCategoria()
	{
		categorias.Add(new Categoria
		{
			Nome = nome,
			Quantidade = quantidade
		});
		nome = "";
		quantidade = 0;
	}
}
